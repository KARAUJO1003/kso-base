# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example committed, never the real ones
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# shadcn registry — gerado por `npm run registry:build` a partir de registry.json,
# nunca editar à mão (ver docs/registry.md)
/public/r/

# typescript
*.tsbuildinfo
next-env.d.ts
