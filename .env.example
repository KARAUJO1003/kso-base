# Ambiente
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# API — aponte para o backend real do projeto. Sem backend, build/lint/lint
# funcionam normalmente, mas listar/salvar dados vai falhar.
NEXT_PUBLIC_DEV_API_BASE_URL=http://localhost:3333
NEXT_PUBLIC_PROD_API_BASE_URL=https://api.seu-dominio.com
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:3333

NEXT_PUBLIC_ENDPOINT_DASH=http://localhost:3000
NEXT_PUBLIC_SSO_FRONT=http://localhost:3000/login
NEXT_PUBLIC_SSO_CLIENT_ID=kso-base
NEXT_PUBLIC_AUTH_SECRET=troque-por-uma-chave-local

NEXT_PUBLIC_COOKIE_NAME=kso
NEXT_PUBLIC_PORT_DASH=3000

# Websocket — deixe vazio para desligar (SocketProvider so conecta se
# FEATURE_FLAGS.websocket.enabled=true E esta URL estiver preenchida).
NEXT_PUBLIC_WEBSOCKET_URL=

NEXT_PUBLIC_BASEURL_FILES=

# Branding — ver src/config/brand.config.ts. Preencha por cliente/projeto.
NEXT_PUBLIC_BRAND_TITLE=Kso Base | Template
NEXT_PUBLIC_BRAND_NAME=Kso Base
NEXT_PUBLIC_BRAND_DESCRIPTION=Template de sistema administrativo
NEXT_PUBLIC_BRAND_URL=https://www.exemplo.com.br
NEXT_PUBLIC_BRAND_OG_IMAGE=https://www.exemplo.com.br/og-image.jpg
NEXT_PUBLIC_BRAND_DEVELOPER=Kso
NEXT_PUBLIC_BRAND_TWITTER=
NEXT_PUBLIC_BRAND_FACEBOOK=
NEXT_PUBLIC_BRAND_INSTAGRAM=

# Modulos desligados por cliente (lista separada por virgula, ex: cargos,motivos-trocas).
# Ver src/modules/registry.ts.
NEXT_PUBLIC_DISABLED_MODULES=
